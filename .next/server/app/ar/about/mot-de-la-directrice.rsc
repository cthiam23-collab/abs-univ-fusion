b:["$","$1","c",{"children":[["$","div",null,{"children":[["$","section",null,{"className":"relative overflow-hidden bg-blue-950 py-20 text-white","children":[["$","div",null,{"className":"absolute inset-0 bg-gradient-to-r from-blue-950 via-blue-950/90 to-blue-900/60"}],["$","div",null,{"className":"container relative mx-auto px-6","children":[["$","p",null,{"className":"font-semibold uppercase tracking-[0.25em] text-cyan-300","children":"المؤسسة"}],["$","h1",null,{"className":"mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl","children":"كلمة المديرة العامة"}],["$","p",null,{"className":"mt-5 max-w-2xl text-lg leading-8 text-blue-100","children":"ننمّي المواهب. نرفع الطموحات. نبني مستقبل أفريقيا."}]]}]]}],["$","section",null,{"className":"container mx-auto px-6 py-16","children":["$","div",null,{"className":"mx-auto grid max-w-5xl gap-10 lg:grid-cols-[240px_1fr] lg:items-start","children":[["$","div",null,{"className":"relative mx-auto overflow-hidden rounded-3xl bg-white shadow-xl lg:sticky lg:top-24","children":[["$","$L12",null,{"src":"/images/documents/dg-seance-travail.jpg","alt":"سخنة مريم تيام، المديرة العامة لـ ABS — African Business School","width":480,"height":600,"className":"h-[320px] w-full object-cover object-top","priority":true}],["$","div",null,{"className":"p-5","children":[["$","p",null,{"className":"font-semibold text-slate-950","children":"سخنة مريم تيام"}],["$","p",null,{"className":"text-sm text-slate-500","children":"المديرة العامة"}],["$","p",null,{"className":"mt-1 text-xs text-slate-400","children":"ABS — African Business School"}]]}]]}],["$","div",null,{"children":[[["$","p","0",{"className":"text-xl font-medium leading-8 text-slate-900","children":"أعزّ الزوار والآباء والطلبة والشركاء،"}],["$","p","1",{"className":"mt-5 leading-8 text-slate-600 first:mt-0","children":"بكل اقتناع وعزيمة أرحّب بكم في موقع ABS — African Business School."}],["$","p","2",{"className":"mt-5 leading-8 text-slate-600 first:mt-0","children":"طموحنا واضح: المساهمة في تكوين جيل أفريقي أكفاء مسؤول جريء، قادر على فهم تحولات العالم، والابتكار، والمشاركة الفاعلة في تنمية مجتمعاتنا."}],["$","p","3",{"className":"mt-5 leading-8 text-slate-600 first:mt-0","children":"أنا مقتنعة اقتناعاً عميقاً بأن الشهادة ليست غاية بذاتها، بل نقطة انطلاق لبناء شخصي ومهني حقيقي. ويتحقق النجاح بفضل صلابة المعارف، وإتقان الكفاءات، وغنى التجربة، وجودة الحكم، وقوة القيم الإنسانية. كما يستلزم أيضاً فهم المحيط، وتوقع تطوراته، وتحويل التحديات إلى فرص للفعل."}],["$","p","4",{"className":"mt-5 leading-8 text-slate-600 first:mt-0","children":"هذا التصور للتعليم هو ما يؤسس التزامنا في ABS. نريد الجمع بين الصرامة الأكاديمية والتطبيق المهني، وتنمية الكفاءات مع الازدهار الشخصي، والمعرفة مع القدرة على الفعل. طموحنا هو إعداد نساء ورجال قادرين على التفكير بصرامة، والاشتغال بجرأة، واتخاذ القرارات ببرؤية ثاقبة، وممارسة مسؤولياتهم بنزاهة."}],["$","p","5",{"className":"mt-5 leading-8 text-slate-600 first:mt-0","children":"في عالم تحوّل بعمق بفعل الرقمنة والذكاء الاصطناعي، أصبح إتقان التقنيات قضية استراتيجية. نعزم إعداد طلبتنا لهذه التحولات، مع الحفاظ على اقتناع أساسي: أن تبقى التقنية في خدمة الذكاء الإنساني، والكرامة، والتقدم الجماعي."}],["$","p","6",{"className":"mt-5 leading-8 text-slate-600 first:mt-0","children":"وفياً لرسالتها القارية الأفريقية، تندرج ABS في منظور أوسع من النجاح الفردي وحده. نريد المساهمة في بروز كفاءات قادرة على تلبية احتياجات مالي، ومرافقة تحولات أفريقيا، وحمل طموحاتها في محيط دولي في تغير مستمر."}],["$","p","7",{"className":"mt-5 leading-8 text-slate-600 first:mt-0","children":"يفرض علينا هذا الطموح صرامة دائمة: تقريب التكوين من الواقعيات المهنية، وتشجيع المبادرة، وزراعة انفتاح العقل، وجعل كل مسار فرصة لتطوير إمكانات الإنسان. فالتكوين ليس مجرد نقل معرفة: بل هو تمكين كل واحد من أن يصبح فاعلاً في مستقبله ومساهماً في تقدم مجتمعه."}],"$L13","$L14","$L15","$L16"],"$L17","$L18","$L19","$L1a","$L1b"]}]]}]}],"$L1c"]}],null,"$L1d"]}]
