 عدة مديرين من الأشخاص الطبيعيين، معينين في النظام الأساسي أو بموجب وثيقة لاحقة. تضمن المديرة القانونية التمثيل القانوني للشركة وتمارس صلاحيات التسيير والتمثيل المنصوص عليها في النصوص المطبقة؛ وتظل الصلاحيات المحفوظة صراحةً للشركاء بموجب القانون أو النظام الأساسي من اختصاصهم."}]]}],["$","div",null,{"className":"rounded-lg border bg-card text-card-foreground shadow-sm border-slate-200","children":[["$","div",null,{"className":"flex flex-col space-y-1.5 p-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-file-text h-9 w-9 text-blue-700","aria-hidden":"true","children":[["$","path","1rqfz7",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["$","path","tnqrlb",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["$","path","b1mrlr",{"d":"M10 9H8"}],["$","path","t4e002",{"d":"M16 13H8"}],["$","path","z1uh3a",{"d":"M16 17H8"}],"$undefined"]}],["$","h3",null,{"className":"font-semibold tracking-tight text-xl text-slate-900","children":"إبراز المهام والوظيفة"}]]}],["$","div",null,{"className":"p-6 pt-0 space-y-3 text-sm","children":[["$","div","التسمية القانونية",{"className":"flex flex-col gap-0.5 border-b border-slate-100 pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-xs font-semibold uppercase tracking-wide text-slate-400","children":"التسمية القانونية"}],["$","span",null,{"className":"font-medium text-slate-800","children":"المديرة القانونية"}]]}],["$","div","اللقب التنفيذي والمؤسسي",{"className":"flex flex-col gap-0.5 border-b border-slate-100 pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-xs font-semibold uppercase tracking-wide text-slate-400","children":"اللقب التنفيذي والمؤسسي"}],["$","span",null,{"className":"font-medium text-slate-800","children":"Managing Director & Chief Executive Officer"}]]}],"$L3","$L4","$L