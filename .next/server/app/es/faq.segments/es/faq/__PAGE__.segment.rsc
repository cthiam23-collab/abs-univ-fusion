2:Tbf0,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"¿Dónde se encuentra ABS?","acceptedAnswer":{"@type":"Answer","text":"La ABS — African Business School está situada en Hamdallaye ACI 2000, Rue 338, Porte 06, en Bamako, en Mali."}},{"@type":"Question","name":"¿Cómo conocer las formaciones abiertas este año?","acceptedAnswer":{"@type":"Answer","text":"Consulte el catálogo del curso académico o contacte con la administración. Los itinerarios expuestos deben ser los efectivamente abiertos para el curso académico correspondiente."}},{"@type":"Question","name":"¿Cómo candidatarse?","acceptedAnswer":{"@type":"Answer","text":"Contacte con la administración a fin de verificar las condiciones de acceso, la lista oficial de los documentos y las modalidades de presentación del expediente."}},{"@type":"Question","name":"¿Cuáles son las tasas de matrícula?","acceptedAnswer":{"@type":"Answer","text":"Las tasas varían según el programa y el curso académico. Consulte el baremo oficial datado o solicite la confirmación a la administración antes de cualquier pago."}},{"@type":"Question","name":"¿ABS propone becas?","acceptedAnswer":{"@type":"Answer","text":"Las posibilidades de becas o de reducción, cuando existen, se anuncian con sus criterios y su periodo de validez. Solo se adquieren tras una decisión oficial."}},{"@type":"Question","name":"¿Las clases incluyen práctica?","acceptedAnswer":{"@type":"Answer","text":"El enfoque pedagógico busca asociar los conocimientos con aplicaciones, proyectos y simulaciones prácticas según las formaciones. Las modalidades exactas figuran en el plan de cada itinerario."}},{"@type":"Question","name":"¿Se enseña inglés?","acceptedAnswer":{"@type":"Answer","text":"El inglés está previsto como competencia transversal en la orientación pedagógica de ABS. Los volúmenes y las modalidades por semestre deben confirmarse en el plan oficial."}},{"@type":"Question","name":"¿Se propone español?","acceptedAnswer":{"@type":"Answer","text":"El español está previsto como lengua complementaria para Relaciones y Asuntos Internacionales. Su organización exacta debe ser confirmada por la administración."}},{"@type":"Question","name":"¿Las prácticas están garantizadas?","acceptedAnswer":{"@type":"Answer","text":"Las prácticas y las inmersiones dependen de las exigencias de la formación, de las modalidades definidas y de las posibilidades de acogida. ABS no debe prometer una colocación automática."}},{"@type":"Question","name":"¿Cómo obtener un certificado o un documento administrativo?","acceptedAnswer":{"@type":"Answer","text":"Dirija su solicitud a la administración por los canales oficiales e indique claramente el documento solicitado así como las informaciones necesarias para su tramitación."}},{"@type":"Question","name":"¿Cómo contactar con ABS?","acceptedAnswer":{"@type":"Answer","text":"Llame al +223 78 14 14 88, escriba a abs.mail1290@gmail.com o utilice el formulario de contacto del sitio."}}]}0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","section",null,{"className":"bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 py-20 text-white","children":"$L3"}],"$L4"]}],["$L5"],"$L6"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"lwTmN1UG9nac6RleI7ViU"}
