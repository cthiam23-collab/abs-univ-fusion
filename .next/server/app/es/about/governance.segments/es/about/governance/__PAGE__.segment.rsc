0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"children":[["$","section",null,{"className":"relative overflow-hidden bg-blue-950 py-20 text-white","children":[["$","$L2",null,{"src":"/images/documents/v3-image3.jpg","alt":"La dirección de ABS en una sesión de trabajo con autoridades oficiales","fill":true,"className":"object-cover opacity-25","priority":true}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-r from-blue-950 via-blue-950/85 to-blue-900/60"}],["$","div",null,{"className":"container relative mx-auto px-6","children":[["$","p",null,{"className":"font-semibold uppercase tracking-[0.25em] text-cyan-300","children":"Quiénes somos · Gobernanza"}],["$","h1",null,{"className":"mt-3 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl","children":"Dirección y gobernanza"}],["$","p",null,{"className":"mt-5 max-w-3xl text-lg leading-8 text-blue-100","children":"La Dirección General asegura la orientación institucional y el desarrollo de ABS. Las responsabilidades académicas, administrativas y pedagógicas se ejercen conforme a la organización interna y a los procedimientos vigentes."}]]}]]}],["$","section",null,{"className":"container mx-auto px-6 py-16","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-semibold uppercase tracking-[0.2em] text-blue-700","children":"Marco jurídico"}],["$","h2",null,{"className":"mt-3 text-3xl font-bold text-slate-900","children":"Una sociedad SARL regida por el derecho OHADA"}],["$","p",null,{"className":"mt-5 leading-7 text-slate-600","children":"ABS — African Business School SARL es una Sociedad de Responsabilidad Limitada (SARL), cuya sede social se encuentra en Bamako, en Mali. La Gerente estatutaria ejerce sus funciones conforme a los estatutos de la sociedad, al Acto Uniforme de la OHADA relativo al derecho de las sociedades comerciales y del agrupamiento de interés económico (AUSCGIE), a las disposiciones aplicables en Mali y a las decisiones debidamente adoptadas por los socios."}],["$","p",null,{"className":"mt-4 leading-7 text-slate-600","children":"Conforme a los artículos 323 y siguientes del AUSCGIE, la SARL es administrada por uno o varios gerentes, personas físicas, nombrados en los estatutos o por un acto posterior. La Gerente estatutaria asegura la representación legal de la sociedad y ejerce los poderes de gestión y de representación previstos por los textos aplicables; los poderes expresamente reservados a los socios por la ley o los estatutos permanecen bajo su competencia."}]]}],["$","div",null,{"className":"rounded-lg border bg-card text-card-foreground shadow-sm border-slate-200","children":[["$","div",null,{"className":"flex flex-col space-y-1.5 p-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-file-text h-9 w-9 text-blue-700","aria-hidden":"true","children":[["$","path","1rqfz7",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["$","path","tnqrlb",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["$","path","b1mrlr",{"d":"M10 9H8"}],["$","path","t4e002",{"d":"M16 13H8"}],["$","path","z1uh3a",{"d":"M16 17H8"}],"$undefined"]}],["$","h3",null,{"className":"font-semibold tracking-tight text-xl text-slate-900","children":"Identificación de la función"}]]}],["$","div",null,{"className":"p-6 pt-0 space-y-3 text-sm","children":[["$","div","Denominación jurídica",{"className":"flex flex-col gap-0.5 border-b border-slate-100 pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-xs font-semibold uppercase tracking-wide text-slate-400","children":"Denominación jurídica"}],"$L3"]}],"$L4","$L5","$L6","$L7","$L8"]}]]}]]}]}],"$L9","$La","$Lb","$Lc"]}],null,"$Ld"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildI