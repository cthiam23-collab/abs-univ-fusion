{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/es/layout,_N_T_/es/library/layout,_N_T_/es/library/page,_N_T_/es/library"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/es/library/__PAGE__",
    "/es/library",
    "/es",
    "/_index",
    "/_head"
  ]
}