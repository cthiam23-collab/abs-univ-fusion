11:Tb58,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where is ABS located?","acceptedAnswer":{"@type":"Answer","text":"ABS — African Business School is located at Hamdallaye ACI 2000, Rue 338, Porte 06, in Bamako, Mali."}},{"@type":"Question","name":"How can I find out which programmes are open this year?","acceptedAnswer":{"@type":"Answer","text":"Consult the intake catalogue or contact the administration. The pathways displayed must be those actually open for the relevant academic year."}},{"@type":"Question","name":"How do I apply?","acceptedAnswer":{"@type":"Answer","text":"Contact the administration to verify the entry requirements, the official list of documents and the arrangements for submitting your application file."}},{"@type":"Question","name":"What are the tuition fees?","acceptedAnswer":{"@type":"Answer","text":"Fees vary depending on the programme and the academic year. Consult the dated official fee schedule or ask the administration for confirmation before making any payment."}},{"@type":"Question","name":"Does ABS offer scholarships?","acceptedAnswer":{"@type":"Answer","text":"Scholarship or reduction opportunities, where they exist, are announced with their criteria and period of validity. They are only granted after an official decision."}},{"@type":"Question","name":"Do the courses include practical work?","acceptedAnswer":{"@type":"Answer","text":"The educational approach aims to combine knowledge with applications, projects and hands-on scenarios depending on the programme. The exact arrangements are set out in the curriculum of each pathway."}},{"@type":"Question","name":"Is English taught?","acceptedAnswer":{"@type":"Answer","text":"English is planned as a transversal skill in ABS's educational orientation. Volumes and arrangements per semester must be confirmed in the official curriculum."}},{"@type":"Question","name":"Is Spanish offered?","acceptedAnswer":{"@type":"Answer","text":"Spanish is considered as a complementary language for International Relations and Affairs. Its exact organisation must be confirmed by the administration."}},{"@type":"Question","name":"Are internships guaranteed?","acceptedAnswer":{"@type":"Answer","text":"Internships and immersions depend on the requirements of the programme, the arrangements defined and the host opportunities available. ABS must not promise automatic placement."}},{"@type":"Question","name":"How can I obtain a certificate or an administrative document?","acceptedAnswer":{"@type":"Answer","text":"Send your request to the administration through the official channels, clearly stating the document requested and the information needed to process it."}},{"@type":"Question","name":"How can I contact ABS?","acceptedAnswer":{"@type":"Answer","text":"Call +223 78 14 14 88, write to abs.mail1290@gmail.com or use the contact form on the website."}}]}b:["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-white","children":[["$","section",null,{"className":"bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 py-20 text-white","children":["$","div",null,{"className":"container mx-auto px-4","children":[["$","div",null,{"className":"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 hover:bg-primary/80 mb-4 border border-cyan-400/40 bg-cyan-400/10 text-cyan-400","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-message-circle-question mr-1 h-3.5 w-3.5","children":[["$","path","vv11sd",{"d":"M7.9 20A9 9 0 1 0 4 16.1L2 22Z"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],"FAQ"]}],["$","h1",null,{"className":"ma