opted by the partners."}],["$","p",null,{"className":"mt-4 leading-7 text-slate-600","children":"In accordance with Article 323 and subsequent articles of the AUSCGIE, the SARL is administered by one or more managers, natural persons, appointed in the articles of association or by a subsequent instrument. The Statutory Manager provides the legal representation of the company and exercises the management and representation powers provided for by the applicable texts; the powers expressly reserved for the partners by law or by the articles of association remain within their remit."}]]}],["$","div",null,{"className":"rounded-lg border bg-card text-card-foreground shadow-sm border-slate-200","children":[["$","div",null,{"className":"flex flex-col space-y-1.5 p-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-file-text h-9 w-9 text-blue-700","aria-hidden":"true","children":[["$","path","1rqfz7",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["$","path","tnqrlb",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["$","path","b1mrlr",{"d":"M10 9H8"}],["$","path","t4e002",{"d":"M16 13H8"}],["$","path","z1uh3a",{"d":"M16 17H8"}],"$undefined"]}],["$","h3",null,{"className":"font-semibold tracking-tight text-xl text-slate-900","children":"Position identification"}]]}],["$","div",null,{"className":"p-6 pt-0 space-y-3 text-sm","children":[["$","div","Legal designation",{"className":"flex flex-col gap-0.5 border-b border-slate-100 pb-3 last:border-0 last:pb-0","children":[["$","span",null,{"className":"text-xs font-semibold uppercase tracking-wide text-slate-400","children":"Legal designation"}],["$","span",null,{"className":"font-medium text-slate-800","children":"Statutory Manager"}]]}],"$L3","$L4","$L5","$L6","$L7"]}]]}]]}]}],"$L8","$L9","$La","$Lb"]}],null,"$Lc"]}],"isPartial":fals