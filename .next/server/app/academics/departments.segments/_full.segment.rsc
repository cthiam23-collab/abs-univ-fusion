33:["$","div",null,{"ref":"$undefined","className":"p-6 pt-6 flex flex-col flex-1","children":[["$","h3",null,{"className":"text-sm font-semibold uppercase tracking-wide text-blue-700 mb-2","children":"Pôle 4 — Journalisme et communication"}],["$","p",null,{"className":"italic text-cyan-700 text-sm mb-3","children":"Informer avec rigueur. Communiquer avec impact. Faire entendre et rayonner les voix africaines."}],["$","p",null,{"className":"text-slate-600 text-sm leading-relaxed mb-5","children":"L'information et la communication influencent la compréhension des enjeux publics, la vie des organisations et la circulation des idées. Le pôle vise à former des professionnels capables de rechercher, vérifier, analyser, produire et diffuser l'information, mais également de concevoir des stratégies de communication adaptées aux objectifs et aux publics. Une attention particulière est accordée à la vérification des faits, à la responsabilité éditoriale et à la lutte contre la désinformation."}],["$","div",null,{"className":"mt-auto","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wide text-blue-700 mb-2","children":"Formation du pôle"}],["$","$L26",null,{"href":"/programs/journalism-communication","className":"text-sm font-medium text-blue-700 hover:text-blue-900 inline-flex items-center gap-1","children":["Licence en Journalisme-Communication"," ",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]]}]
