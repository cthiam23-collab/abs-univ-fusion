import { CtaDestination } from "@/components/content/cta-destination"
export default async function Page({ params }: { params: Promise<{ slug: string }> }) { const { slug } = await params; return <CtaDestination title={slug.replaceAll("-", " ")} description="Explore MBA opportunities and practical business learning at African Business School (ABS) in Bamako." primaryHref="/programs/masters/mba" /> }
