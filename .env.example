# =============================================================================
# ABS-UNIVERSITE — Environment Variables Template
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://supabase.abs-univ.com:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# ── PostgreSQL (via Supabase) ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@supabase.abs-univ.com:8000/postgres

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=<your-github-token>

# ── Hostinger ────────────────────────────────────────────────────────────────
# (to be configured when domain/hosting purchased)
