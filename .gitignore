# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc

# Environment variables
# .env holds real secrets (service role key, JWT secret, database password) and
# was tracked by mistake. Everything named .env* stays local; only the templates
# without values are tracked, so a fresh clone still knows which keys to set.
.env
.env.*
!.env.example
!.env.production.template

# Build output
dist/
build/
.out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
